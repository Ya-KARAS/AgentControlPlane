{
  "name": "agent-control-plane",
  "version": "0.9.0",
  "private": true,
  "license": "AGPL-3.0",
  "description": "A local, model-agnostic control plane that lets web AI dispatch compact briefs to interchangeable engineering executors.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && node scripts/build-userscript.js --check && node scripts/check-docs-links.js && node scripts/check-browser-companion.js",
    "verify": "npm test && npm run check",
    "companion:check": "node scripts/check-browser-companion.js",
    "userscript:build": "node scripts/build-userscript.js",
    "userscript:check": "node scripts/build-userscript.js --check",
    "doctor": "node scripts/doctor.js",
    "demo": "node scripts/demo.js",
    "release:package": "node scripts/package-release.js",
    "release:sha256": "node scripts/sha256-manifest.js",
    "smoke": "node scripts/smoke.js",
    "smoke:companion": "node scripts/smoke-companion.js",
    "harness:companion": "node scripts/serve-companion-harness.js",
    "smoke:budget": "node scripts/smoke-budget.js",
    "benchmark:real": "node scripts/benchmark-real.js",
    "benchmark:report": "node scripts/benchmark-report.js",
    "benchmark:recommend": "node scripts/benchmark-recommend.js",
    "verify:audit": "node scripts/verify-audit.js",
    "sandbox:setup": "node scripts/setup-windows-sandbox.js",
    "check:relay": "node scripts/check-relay.js",
    "accept:reroute": "node scripts/accept-reroute.js",
    "key:fingerprint": "node scripts/key-fingerprint.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  }
}
